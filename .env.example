# Copy to .env and fill in. `docker compose up` reads it automatically.

# Signs session tokens. Generate one with:  openssl rand -hex 32
# There is deliberately no default: every deployment sharing a key would mean
# anyone could mint a token for any user.
JWT_SECRET=

# The port the API is published on. Change if 8000 is taken.
API_PORT=8000

# Database credentials. Fine as they are for local use; change for anything
# reachable from outside your machine.
POSTGRES_USER=geofatali
POSTGRES_PASSWORD=geofatali
POSTGRES_DB=geofatali

# Set to `production` to make the service refuse to start without a real
# DATABASE_URL and JWT_SECRET.
GEOFATALI_ENV=development
