# Copy to deploy/.env and fill in. Never commit the filled-in file.

# The hostname pointing at this machine. Its A record must already resolve
# here, or Let's Encrypt cannot issue a certificate.
DOMAIN=api.geofatali.com

# Where certificate expiry notices go.
ACME_EMAIL=you@example.com

# Database password. Generate one:  openssl rand -base64 24
POSTGRES_PASSWORD=

# Signs session tokens. Generate one:  openssl rand -hex 32
# Changing it signs everyone out, which is the intended way to revoke
# every session at once.
JWT_SECRET=

POSTGRES_USER=geofatali
POSTGRES_DB=geofatali
